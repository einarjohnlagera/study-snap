{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "subject", "tags", "keyConcepts", "quiz"],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "subject": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32
      }
    },
    "keyConcepts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "choices",
          "answer",
          "explanation",
          "concept",
          "questionFormat",
          "questionGroup",
          "correctIndices",
          "questionType",
          "workingSolution"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string",
            "enum": ["A", "B", "C", "D"]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "questionFormat": {
            "type": ["string", "null"],
            "enum": ["MCQ", "TRUE_FALSE", "MULTI_SELECT", "MATCHING", null]
          },
          "questionGroup": {
            "type": ["string", "null"],
            "maxLength": 32
          },
          "correctIndices": {
            "anyOf": [
              {
                "type": "array",
                "items": {"type": "integer"}
              },
              {"type": "null"}
            ]
          },
          "questionType": {
            "type": ["string", "null"],
            "enum": ["CONCEPTUAL", "COMPUTATIONAL", null]
          },
          "workingSolution": {
            "type": ["string", "null"]
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          }
        }
      }
    }
  }
}
