{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "subject", "tags", "keyConcepts", "quiz"],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32
      }
    },
    "keyConcepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "choices",
          "answerIndex",
          "concept",
          "explanation"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "answerIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}
